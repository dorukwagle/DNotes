<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.doruk.dnotes</groupId>
    <artifactId>DNotes</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <javafx.version>24.0.1</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- RichTextFX and its non-modular dependencies -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>org.reactfx</groupId>
            <artifactId>reactfx</artifactId>
            <version>2.0-M5</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.flowless</groupId>
            <artifactId>flowless</artifactId>
            <version>0.6.10</version>
        </dependency>

        <!-- Atlantafx -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Ikonli -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-materialdesign2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>24</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-requires-automatic</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Moditect RC2 -->
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>1.0.0.RC2</version>
                <executions>
                    <execution>
                        <id>modularize-reactfx</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>add-module-info</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/modular-deps</outputDirectory>
                            <modules>
                                <!-- ReactFX -->
                                <module>
                                    <artifact>
                                        <groupId>org.reactfx</groupId>
                                        <artifactId>reactfx</artifactId>
                                        <version>2.0-M5</version>
                                    </artifact>
                                    <inlineModuleInfo>
                                        <![CDATA[
                                        module org.reactfx {
                                            exports org.reactfx;
                                            exports org.reactfx.collection;
                                            exports org.reactfx.util;
                                            exports org.reactfx.value;
                                        }
                                        ]]>
                                    </inlineModuleInfo>
                                </module>

                                <!-- Flowless -->
                                <module>
                                    <artifact>
                                        <groupId>org.fxmisc.flowless</groupId>
                                        <artifactId>flowless</artifactId>
                                        <version>0.6.10</version>
                                    </artifact>
                                    <inlineModuleInfo>
                                        <![CDATA[
                                        module org.fxmisc.flowless {
                                            requires javafx.base;
                                            requires javafx.graphics;
                                            requires javafx.controls;
                                            requires org.reactfx;
                                            exports org.fxmisc.flowless;
                                        }
                                        ]]>
                                    </inlineModuleInfo>
                                </module>

                                <!-- RichTextFX -->
                                <module>
                                    <artifact>
                                        <groupId>org.fxmisc.richtext</groupId>
                                        <artifactId>richtextfx</artifactId>
                                        <version>0.11.5</version>
                                    </artifact>
                                    <inlineModuleInfo>
                                        <![CDATA[
                                        module org.fxmisc.richtext {
                                            requires javafx.base;
                                            requires javafx.graphics;
                                            requires javafx.controls;
                                            requires org.reactfx;
                                            requires org.fxmisc.flowless;
                                            exports org.fxmisc.richtext;
                                            exports org.fxmisc.richtext.model;
                                        }
                                        ]]>
                                    </inlineModuleInfo>
                                </module>
                            </modules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaFX jlink -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>jlink</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                        <configuration>
                            <stripDebug>true</stripDebug>
                            <compress>2</compress>
                            <noHeaderFiles>true</noHeaderFiles>
                            <noManPages>true</noManPages>
                            <launcher>DNotes</launcher>
                            <jlinkImageName>dnotes-runtime</jlinkImageName>
                            <jlinkZipName>dnotes-distribution</jlinkZipName>
                            <mainClass>com.doruk.dnotes/com.doruk.dnotes.App</mainClass>
                            <modulePath>
                                ${project.build.directory}/modular-deps
                                ${java.home}/jmods
                            </modulePath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JPackage -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.6</version>
                <configuration>
                    <type>DEB</type>
                    <runtimeImage>${project.build.directory}/dnotes-runtime</runtimeImage>
                    <destination>${project.build.directory}/installer</destination>
                    <name>DNotes</name>
                    <appVersion>1.0.0</appVersion>
                    <mainClass>com.doruk.dnotes.App</mainClass>
                    <module>com.doruk.dnotes</module>
                    <icon>src/main/resources/dnotes.png</icon>
                    <vendor>Doruk</vendor>
                    <copyright>Doruk © 2025</copyright>
                </configuration>
            </plugin>

        </plugins>
    </build>
</project>
