<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.doruk.dnotes</groupId>
    <artifactId>DNotes</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <javafx.version>25</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
    </properties>

    <dependencies>
        <!-- JavaFX modules -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Atlantafx -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Ikonli -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-materialdesign2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- RichTextFX and its transitive dependencies -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.6</version>
        </dependency>
        <dependency>
            <groupId>org.reactfx</groupId>
            <artifactId>reactfx</artifactId>
            <version>2.0-M6</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.flowless</groupId>
            <artifactId>flowless</artifactId>
            <version>0.7.4</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.undo</groupId>
            <artifactId>undofx</artifactId>
            <version>2.1.1</version>
        </dependency>

        <!-- SQLite JDBC -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <!-- Standard compiler and JavaFX plugins remain -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.doruk.dnotes.Main</mainClass>
                </configuration>
            </plugin>
            <!--
            ============================================================================
            REMOVED: maven-shade-plugin and jpackage-maven-plugin.
            They are replaced by the GraalVM Native Build Tools plugin.
            ============================================================================
            -->
        </plugins>
    </build>
    <profiles>
        <!--
        ============================================================================
        OS-SPECIFIC PROFILES
        These profiles are activated automatically based on the build environment.
        Their only job is to set a property with the correct path to the native
        SQLite library for the current operating system.
        ============================================================================
        -->
        <profile>
            <id>native-linux</id>
            <activation>
                <os><family>linux</family></os>
            </activation>
            <properties>
                <sqlite.native.library>org/sqlite/native/Linux/x86_64/libsqlitejdbc.so</sqlite.native.library>
                <!-- This argument is to link required static libraries for JavaFX on Linux -->
                <buildArg>-J-Dorg.graalvm.nativeimage.imagecode=linker</buildArg>
            </properties>
        </profile>
        <profile>
            <id>native-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <sqlite.native.library>org/sqlite/native/Windows/x86_64/sqlitejdbc.dll</sqlite.native.library>
            </properties>
        </profile>
        <profile>
            <id>native-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <sqlite.native.library>org/sqlite/native/Mac/x86_64/libsqlitejdbc.dylib</sqlite.native.library>
            </properties>
    </profile>

    <!--
    ============================================================================
    PROFILE 1: 'native'
    This is the main profile you activate to trigger a GraalVM native build.
    You will run: mvn package -Pnative
    It uses the property set by the OS-specific profiles above.
    ============================================================================
    -->
    <profile>
        <id>native</id>
        <build>
            <plugins>
                <!-- This plugin provides necessary GraalVM configuration for JavaFX itself. -->
                <plugin>
                    <groupId>com.gluonhq</groupId>
                    <artifactId>gluonfx-maven-plugin</artifactId>
                    <version>1.0.28</version>
                    <executions>
                        <execution>
                            <id>attach-graalvm-configuration</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>attach-graalvm-configuration</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- This is the main GraalVM Native Build Tools plugin. -->
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.11.2</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals>
                                <goal>build</goal>
                            </goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <imageName>DNotes</imageName>
                        <mainClass>com.doruk.dnotes.Main</mainClass>
                        <buildArgs>
                            <buildArg>--no-fallback</buildArg>
                            <buildArg>--enable-all-security-services</buildArg>
                            <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                            <buildArg>-H:+AddAllCharsets</buildArg>
                            <buildArg>-H:EnableURLProtocols=http,https</buildArg>
                            <!-- FIX: Added argument to enable native access for SQLite JDBC -->
                            <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                        </buildArgs>
                        <resources>
                            <includes>
                                <include>.*\.css</include>
                                <include>.*\.png</include>
                                <include>.*\.ttf</include>
                                <include>.*\.fxml</include>
                                <!-- FIX: This now uses the property that was set by the active OS profile -->
                                <include>${sqlite.native.library}</include>
                            </includes>
                        </resources>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>

    <!--
    ============================================================================
    PROFILE 2: 'agent'
    This profile configures the tracing agent to generate native-image config.
    You will run: mvn javafx:run -Pagent
    ============================================================================
    -->
    <profile>
        <id>agent</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                    <configuration>
                        <mainClass>com.doruk.dnotes.Main</mainClass>
                        <options>
                            <option>-agentlib:native-image-agent=config-output-dir=src/main/resources/META-INF/native-image</option>
                        </options>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>
</profiles>
</project>