<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.doruk.dnotes</groupId>
    <artifactId>DNotes</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <javafx.version>25</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
    </properties>

    <dependencies>
        <!-- JavaFX modules -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Atlantafx -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Ikonli -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-materialdesign2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- RichTextFX and its transitive dependencies -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.6</version>
        </dependency>
        <dependency>
            <groupId>org.reactfx</groupId>
            <artifactId>reactfx</artifactId>
            <version>2.0-M6</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.flowless</groupId>
            <artifactId>flowless</artifactId>
            <version>0.7.4</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.undo</groupId>
            <artifactId>undofx</artifactId>
            <version>2.1.1</version>
        </dependency>

        <!-- SQLite JDBC -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Java Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>

<!--            javafx maven plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>com.doruk.dnotes.Main</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.doruk.dnotes.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <includes>
                                        <include>META-INF/versions/9/org/sqlite/nativeimage/**</include> <!-- Preserve SQLite feature -->
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.7.1</version>
                <configuration>
                    <!-- Basic application metadata -->
                    <name>dNotes</name>
                    <appVersion>${project.version}</appVersion>
                    <vendor>Doruk Inc.</vendor>
                    <copyright>Copyright (c) 2025 Doruk Inc.</copyright>

                    <!--
                    CRUCIAL: Path to a full JDK to bundle with the app.
                    This completely bypasses jlink and its modularity checks.
                    You MUST change this path to point to a JDK 21 installation on your build machine.
                    -->
                    <runtimeImage>/usr/lib/jvm/graalvm-25</runtimeImage>
                    <!-- On Linux/macOS, it would be like: <runtimeImage>/usr/lib/jvm/java-21-openjdk-amd64</runtimeImage> -->
                    <type>APP_IMAGE</type>
                    <input>${project.build.directory}</input>
                    <!--
                    Input for jpackage: Point to the fat JAR created by the shade plugin.
                    This is the simplest way to provide your application and all its dependencies.
                    -->
                    <mainJar>${project.build.finalName}.jar</mainJar>
                    <mainClass>com.doruk.dnotes.Main</mainClass>

                    <!-- Destination for the installer -->
                    <destination>${project.build.directory}/dist</destination>

                    <!-- Platform-specific icon configuration -->
                    <icon>src/main/resources/icon.png</icon> <!-- For Windows (.ico) -->
<!--                    <macIcon>src/main/resources/icon.png</macIcon> &lt;!&ndash; For macOS (.icns) &ndash;&gt;-->
<!--                    <linuxIcon>src/main/resources/icon.png</linuxIcon> &lt;!&ndash; For Linux (.png) &ndash;&gt;-->

                    <!--
                    File association for .dnt files.
                    This tells the OS that your app can open these files.
                    -->
                    <fileAssociations>src/main/resources/dnt-associations.properties</fileAssociations>

                    <!-- Optional: JVM options for your application -->
<!--                    <vmArgs>-->
<!--                        <vmArg>-Xmx128m</vmArg>-->
<!--                    </vmArgs>-->
                </configuration>
                <executions>
                    <execution>
                        <id>jpackage</id>
                        <!-- Bind to the 'verify' phase, which runs after 'package' -->
                        <phase>verify</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>com.gluonhq</groupId>-->
<!--                <artifactId>gluonfx-maven-plugin</artifactId>-->
<!--                <version>1.0.27</version>-->
<!--                <configuration>-->
<!--                    <mainClass>com.doruk.dnotes.App</mainClass>-->
<!--                    <target>host</target>-->
<!--                    <verbose>true</verbose>-->
<!--                    <bundlesList>-->
<!--                        <list>com/sun/javafx/tk/quantum/QuantumMessagesBundle</list>-->
<!--                    </bundlesList>-->
<!--                    <resourcesList>-->
<!--                        <list>.*\.css$</list>-->
<!--                        <list>.*\.png$</list>-->
<!--                        &lt;!&ndash; Add other resource patterns if needed, e.g., FXML &ndash;&gt;-->
<!--                        &lt;!&ndash; <list>.*\.fxml$</list> &ndash;&gt;-->
<!--                    </resourcesList>-->
<!--                    <reflectionList>-->
<!--                        &lt;!&ndash; Add classes requiring reflection, e.g., for RichTextFX &ndash;&gt;-->
<!--                    </reflectionList>-->
<!--                    <enableSWRendering>false</enableSWRendering>-->
<!--                </configuration>-->
<!--            </plugin>-->
        </plugins>
    </build>
</project>